#!/usr/bin/env bash
#### tst — run Playwright tests in a one-shot podman container.
#### Server-only script. Invoke it via SSH from the client, or run it
#### directly when sitting at the Server.
#
#### Usage: tst [playwright args...]
####   e.g. tst --list
####        tst tests/foo.spec.js
####        tst -g "login"
#        tst --update-snapshots
#
#### Env:
####   TST_IMAGE      podman image (default: mcr.microsoft.com/playwright:v1.61.0-noble)
####   TST_HOST_WS    server-side path to the working tree (default: /home/user/GitHub/linebyline)
#
#### Syncthing sync (automatic — reads API key from the server's Syncthing
#### config XML):
####   The script auto-detects the Syncthing API key from the server's own
####   config file. No env vars required — a bare `ssh Server tst` works.
####   If the config can't be found, the sync check is skipped (tests run
####   regardless).
####   Optional env vars (override auto-detection):
####   SYNCTHING_API_KEY    — Syncthing GUI API key
####   SYNCTHING_LBL_ID     — LineByLine folder ID (auto-detected if unset)
####   SYNCTHING_CLIENT_ID  — client device ID (auto-detected if unset)
#
#### Pre-test sync (server's PoV):
####   Triggers a local rescan of ONLY the LineByLine folder, then polls the
####   local folder status (/rest/db/status) until state=="idle" and
####   needBytes==0. This ensures the server has received all pending changes
####   from the client before running tests.
#
#### Post-test artifact pull:
####   If tests fail, copies trash/ to scratch/upload/trash/ (bypasses the
####   trash/ sync issue — trash/ is gitignored + Playwright holds files open).
####   Then triggers a local rescan so the client pulls the artifacts from
####   scratch/upload/.
#
#### LBL_VITE_TARGET is hardcoded to 1 — the monolith is gone.
#
#### Prereq: the host's working tree must have node_modules/ installed
#### (run npm ci once on the client; Syncthing ships it to the server).
set -euo pipefail

image=${TST_IMAGE:-mcr.microsoft.com/playwright:v1.61.0-noble}
host_workspace=${TST_HOST_WS:-/home/user/GitHub/linebyline}

#### Refuse to run outside a Playwright repo.
if [ ! -f "$host_workspace/playwright.config.js" ]; then
  echo "tst: $host_workspace/playwright.config.js not found" >&2
  echo "tst: is the working tree synced? Is TST_HOST_WS set to a real repo?" >&2
  exit 1
fi

# ── Auto-detect Syncthing config ──────────────────────────────────────────────
# Read the API key from the server's Syncthing config XML. Try common paths
# across distros + Docker volume mounts.
#
# Override: set TST_SYNCTHING_CONFIG to the config.xml path if auto-detection
# fails (e.g. Syncthing in a non-standard Docker volume location).
#
# Priority:
#   1. $TST_SYNCTHING_CONFIG (explicit override)
#   2. $SYNCTHING_API_KEY env var (set in interactive fish/bash shell)
#   3. Standard XDG paths (~/.local/state/syncthing/, ~/.config/syncthing/)
#   4. Docker compose volume paths (common patterns: ~/Docker/syncthing/,
#      ~/docker/syncthing/, /run/media/*/Backup/Scripts/Docker/syncthing/)
#   5. `syncthing --paths config` if the binary is on PATH
syncthing_config="${TST_SYNCTHING_CONFIG:-}"

if [ -z "$syncthing_config" ]; then
  for cfg in \
    "$HOME/.local/state/syncthing/config.xml" \
    "$HOME/.config/syncthing/config.xml" \
    "/home/user/.local/state/syncthing/config.xml" \
    "/home/user/.config/syncthing/config.xml" \
    "$HOME/Docker/syncthing/config/config.xml" \
    "$HOME/docker/syncthing/config/config.xml" \
    "$HOME/Scripts/Docker/syncthing/config/config.xml" \
    "/run/media/$USER/Backup/Scripts/Docker/syncthing/config/config.xml"; do
    if [ -f "$cfg" ]; then
      syncthing_config="$cfg"
      break
    fi
  done
fi

# Also try `syncthing --paths config` if the binary is available and config
# wasn't found at the standard paths.
if [ -z "$syncthing_config" ] && command -v syncthing >/dev/null 2>&1; then
  syncthing_config=$(syncthing --paths config 2>/dev/null || true)
fi

SYNCTHING_API_KEY="${SYNCTHING_API_KEY:-}"
if [ -z "$SYNCTHING_API_KEY" ] && [ -n "$syncthing_config" ] && [ -f "$syncthing_config" ]; then
  SYNCTHING_API_KEY=$(grep -oP '<apikey>\K[^<]+' "$syncthing_config" 2>/dev/null || true)
fi

# ── Syncthing pre-test sync (automatic if API key is available) ──────────────
# From the SERVER's perspective:
#   1. Find the LineByLine folder ID (by path match — scan only that folder,
#      not all folders).
#   2. Trigger a local rescan of that folder (detect local changes).
#   3. Poll /rest/db/status?folder=X until state=="idle" and needBytes==0.
#      - needBytes > 0 → the server is receiving data from the client (wait)
#      - state != "idle" → scanning or syncing (wait)
#      - needBytes==0 && state=="idle" → server has everything (proceed)
#   This is the correct PoV: the server checks ITS OWN status, not the
#   client's completion (which would be the server→client direction — wrong
#   for pre-test sync).
if [ -n "$SYNCTHING_API_KEY" ]; then
  # Auto-detect the LineByLine folder ID: find the folder whose path contains
  # "linebyline". This scans only the folders list (cheap), not all folder data.
  folder_id="${SYNCTHING_LBL_ID:-}"
  if [ -z "$folder_id" ]; then
    folder_id=$(curl -s -H "X-API-Key: $SYNCTHING_API_KEY" \
      "http://127.0.0.1:8384/rest/config/folders" 2>/dev/null \
      | jq -r '.[] | select(.path | test("linebyline"; "i")) | .id' 2>/dev/null \
      | head -1 || true)
  fi

  if [ -n "$folder_id" ]; then
    echo "tst: triggering Syncthing rescan of linebyline folder..."
    curl -s -X POST -H "X-API-Key: $SYNCTHING_API_KEY" \
      "http://127.0.0.1:8384/rest/db/scan?folder=$folder_id" >/dev/null 2>&1 || true

    echo "tst: polling local folder status..."
    for i in $(seq 1 120); do
      status_json=$(curl -s -H "X-API-Key: $SYNCTHING_API_KEY" \
        "http://127.0.0.1:8384/rest/db/status?folder=$folder_id" 2>/dev/null || echo '{}')
      state=$(echo "$status_json" | jq -r '.state // "unknown"' 2>/dev/null || echo "unknown")
      need_bytes=$(echo "$status_json" | jq -r '.needBytes // 0' 2>/dev/null || echo 0)

      if [ "$state" = "idle" ] && [ "$need_bytes" = "0" ]; then
        echo "tst: sync complete (idle, 0 needBytes)"
        break
      fi
      if [ $((i % 10)) -eq 0 ]; then
        echo "tst: sync at state=${state}, needBytes=${need_bytes}..."
      fi
      sleep 2
    done
  else
    echo "tst: WARNING — could not auto-detect linebyline folder ID; skipping sync check" >&2
  fi
else
  echo "tst: WARNING — could not read Syncthing API key; skipping sync check" >&2
  if [ -n "$syncthing_config" ]; then
    echo "tst: (config found at $syncthing_config but <apikey> tag not matched)" >&2
  else
    echo "tst: (no Syncthing config found at standard or Docker paths)" >&2
    echo "tst: (looked in ~/.local/state/syncthing/, ~/.config/syncthing/," >&2
    echo "tst:  ~/Docker/syncthing/, ~/docker/syncthing/," >&2
    echo "tst:  /run/media/\$USER/Backup/Scripts/Docker/syncthing/)" >&2
    echo "tst: Set TST_SYNCTHING_CONFIG=/path/to/config.xml to override." >&2
  fi
fi

# ── Clean trash/ from previous runs ──────────────────────────────────────────
# Stale actuals in trash/ can confuse toMatchSnapshot results.
rm -rf -- "${host_workspace:?}/trash" 2>/dev/null || true

podman pull -q "$image" >/dev/null 2>&1 || true

# LBL_VITE_TARGET=1 is hardcoded — the monolith is gone.
env_args=(-e PW_CONTAINER=1 -e LBL_VITE_TARGET=1)

# Capture Playwright output for failure detection + artifact pull.
pw_tmp=$(mktemp)
trap 'rm -f -- "$pw_tmp" 2>/dev/null || true' EXIT

set +e
podman run --rm \
  --userns=keep-id --security-opt label=disable \
  -v "$host_workspace:/workspace" -w /workspace \
  -e HOME=/tmp \
  -e NPM_CONFIG_UPDATE_NOTIFIER=false \
  "${env_args[@]}" \
  "$image" npx playwright test "$@" 2>&1 | tee "$pw_tmp"
pw_exit=${PIPESTATUS[0]}
set -e

# ── Pull trash/ artifacts via scratch/upload/ (if there were failures) ───────
# Syncthing doesn't reliably sync trash/ directly (gitignored + Playwright
# holds files open during runs). Copy trash/ to scratch/upload/trash/ so
# Syncthing syncs the artifacts to the client, then trigger a local rescan.
if grep -qE '^[[:space:]]*[0-9]+[[:space:]]+failed' "$pw_tmp" 2>/dev/null; then
  echo "tst: failures detected — copying trash/ to scratch/upload/ for client sync..."
  mkdir -p "$host_workspace/scratch/upload"
  cp -r "$host_workspace/trash" "$host_workspace/scratch/upload/" 2>/dev/null || true
  # Trigger a local rescan so the server detects the new files in
  # scratch/upload/trash/ and pushes them to the client.
  if [ -n "${SYNCTHING_API_KEY:-}" ] && [ -n "${folder_id:-}" ]; then
    curl -s -X POST -H "X-API-Key: $SYNCTHING_API_KEY" \
      "http://127.0.0.1:8384/rest/db/scan?folder=$folder_id" >/dev/null 2>&1 || true
    echo "tst: server rescan triggered (client will pull scratch/upload/trash/)"
  fi
fi

exit "$pw_exit"
